// Cloudflare Workers config: serves this repo's static files (no server code).
// Deployed by .github/workflows/deploy.yml on every push to main.
{
  "name": "digital-beachhead",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "thedigitalbeachhead.com", "custom_domain": true },
    { "pattern": "www.thedigitalbeachhead.com", "custom_domain": true }
  ]
}
