// Cloudflare Workers config.
// Serves this repo's static files, plus a small shared smile counter at /api/smiles (src/worker.js).
// Deployed by .github/workflows/deploy.yml on every push to main.
{
  "name": "digital-beachhead",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SMILES", "class_name": "SmileCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SmileCounter"] }],
  "routes": [
    { "pattern": "thedigitalbeachhead.com", "custom_domain": true },
    { "pattern": "www.thedigitalbeachhead.com", "custom_domain": true }
  ]
}
